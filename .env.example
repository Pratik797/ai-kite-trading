# Copy this file to .env and fill in real values. NEVER commit .env to git.
# This pass (foundation + backtesting) does not require any of these to be set —
# the backtester runs entirely on historical data with no live credentials.

# --- Phase 2/9: Kite Connect (not needed yet) ---
KITE_API_KEY=
KITE_API_SECRET=
KITE_ACCESS_TOKEN=

# --- Phase 5: Anthropic API for the AI Analysis module (not needed yet) ---
# Distinct from a Claude Pro / Claude Code subscription — this is a separate,
# usage-billed API key from https://console.anthropic.com
ANTHROPIC_API_KEY=

# --- Database ---
# SQLite for development (default, no setup needed). Point at Postgres in production.
DATABASE_URL=sqlite:///./trading.db

# --- Capital / risk profile (matches project spec defaults) ---
TOTAL_CAPITAL_INR=5000
PROTECTED_CAPITAL_INR=4000
ACTIVE_TRADING_CAPITAL_INR=1000
RISK_PER_TRADE_PCT=1.5
DAILY_LOSS_CEILING_INR=50
MAX_OPEN_POSITIONS=2
